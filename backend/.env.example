# app
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# database (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/christianity_ai

# gemini (google-genai)
GEMINI_API_KEY=
MODEL_MAIN=gemini-2.5-pro
MODEL_SAFETY=gemini-2.5-flash

# embeddings (local sentence-transformers, no API)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# image generation (Imagen via google-genai)
IMAGE_MODEL=imagen-3.0-generate-002
